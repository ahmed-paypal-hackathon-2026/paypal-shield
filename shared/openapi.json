{
  "openapi": "3.1.0",
  "info": {
    "title": "PayPal Shield API",
    "version": "1.0.0",
    "description": "Real-time risk evaluation and Buyer Protection Fee layer for PayPal Checkout. This is the frozen contract: Paginated exports are regenerated by CI and must diff empty against backend.app.main.openapi()."
  },
  "servers": [
    { "url": "http://localhost:8000", "description": "Local development (Docker Compose)" },
    { "url": "https://api-m.sandbox.paypal.com", "description": "PayPal Sandbox upstream (called server-side only)" }
  ],
  "paths": {
    "/api/v1/quotes": {
      "post": {
        "operationId": "createQuote",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QuoteRequest" } } } },
        "responses": {
          "200": { "description": "Risk assessment and, when coverage is available, a signed quote", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QuoteResponse" } } } },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/api/v1/orders": {
      "post": {
        "operationId": "createOrder",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateOrderRequest" } } } },
        "responses": {
          "201": { "description": "PayPal Orders v2 order created; idempotent over repeated submissions", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateOrderResponse" } } } }
        }
      }
    },
    "/api/v1/orders/{id}/capture": {
      "post": {
        "operationId": "captureOrder",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": {
          "200": { "description": "Capture completed or already captured (replay returns stored result)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CaptureResponse" } } } }
        }
      }
    },
    "/api/v1/claims": {
      "post": {
        "operationId": "submitClaim",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "order_id": { "type": "string" },
                  "photo": { "type": "string", "format": "binary", "description": "jpeg/png/webp, validated by magic bytes" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Claim accepted and entering the arbiter pipeline", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClaimRecord" } } } }
        }
      }
    },
    "/api/v1/claims/{id}": {
      "get": {
        "operationId": "getClaim",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": {
          "200": { "description": "Current claim record", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClaimRecord" } } } }
        }
      }
    },
    "/api/v1/claims/{id}/resolve": {
      "post": {
        "operationId": "resolveClaim",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object",
          "required": ["decision"],
          "properties": {
            "decision": { "type": "string", "enum": ["REFUND", "REJECT"] },
            "reason_code": { "type": "string" }
          }
        } } } },
        "responses": {
          "200": { "description": "Reviewer decision applied; refund triggers only when COMPLETED", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClaimRecord" } } } }
        }
      }
    },
    "/api/v1/ledger/transactions": {
      "get": {
        "operationId": "listTransactions",
        "responses": { "200": { "description": "Order transaction rows", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/TransactionRow" } } } } } }
      }
    },
    "/api/v1/ledger/merchants": {
      "get": {
        "operationId": "listMerchants",
        "responses": { "200": { "description": "Merchant trust registry rows", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/MerchantTrustRow" } } } } } }
      }
    },
    "/api/v1/ledger/summary": {
      "get": {
        "operationId": "ledgerSummary",
        "responses": { "200": { "description": "Network-level totals shown in the pinned grid row", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LedgerSummary" } } } } }
      }
    },
    "/api/v1/stream": {
      "get": {
        "operationId": "streamEvents",
        "description": "Server-Sent Events: event types transaction|claim|merchant; data is a JSON envelope {topic, action, record}.",
        "responses": {
          "200": {
            "description": "text/event-stream",
            "content": {
              "text/event-stream": {
                "schema": { "type": "object", "properties": { "topic": { "type": "string" }, "action": { "type": "string" }, "record": {} } }
              }
            }
          }
        }
      }
    },
    "/api/v1/webhooks/paypal": {
      "post": {
        "operationId": "paypalWebhook",
        "description": "Five-header signature verification then event_id deduplication. Returns 200 for verified or duplicate deliveries.",
        "responses": { "200": { "description": "Verified or duplicate delivery acknowledged" }, "400": { "description": "Signature verification failed" } }
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service status",
            "content": { "application/json": { "schema": {
              "type": "object",
              "required": ["status", "paypal_sandbox_connected", "demo_mode"],
              "properties": {
                "status": { "type": "string" },
                "paypal_sandbox_connected": { "type": "boolean" },
                "demo_mode": { "type": "boolean" }
              }
            } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GateDecision": { "type": "string", "enum": ["COVERAGE_AVAILABLE", "BLOCKED_HIGH_RISK", "MANUAL_REVIEW", "UNSUPPORTED_CURRENCY"] },
      "ClaimState": { "type": "string", "enum": ["SUBMITTED", "EVIDENCE_CHECKED", "AUTO_APPROVED", "MANUAL_REVIEW", "REJECTED", "REFUNDED"] },
      "CacheStatus": { "type": "string", "enum": ["HIT", "COMPUTED", "MISS_DEFAULT", "DEMO"] },
      "PillarScores": {
        "type": "object",
        "required": ["s_visual", "s_semantic", "s_reviews", "s_price", "is_ai_generated", "cache_status"],
        "properties": {
          "s_visual": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
          "s_semantic": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
          "s_reviews": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
          "s_price": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
          "is_ai_generated": { "type": "boolean" },
          "reason_codes": { "type": "array", "items": { "type": "string" } },
          "model_versions": { "type": "object", "additionalProperties": { "type": "string" } },
          "cache_status": { "$ref": "#/components/schemas/CacheStatus" }
        }
      },
      "RiskAssessment": {
        "type": "object",
        "required": ["item_hash", "merchant_id", "pillars", "trust_score", "s_merchant", "r_base", "m_penalty", "r_final", "gate"],
        "properties": {
          "item_hash": { "type": "string" },
          "merchant_id": { "type": "string" },
          "pillars": { "$ref": "#/components/schemas/PillarScores" },
          "trust_score": { "type": "string" },
          "s_merchant": { "type": "string" },
          "r_base": { "type": "string" },
          "m_penalty": { "type": "string" },
          "r_final": { "type": "string", "description": "percent, two decimals" },
          "gate": { "$ref": "#/components/schemas/GateDecision" }
        }
      },
      "ProtectionQuote": {
        "type": "object",
        "required": ["quote_id", "merchant_id", "item_hash", "item_price", "currency_code", "protection_fee", "expires_at", "hmac_signature"],
        "properties": {
          "quote_id": { "type": "string" },
          "merchant_id": { "type": "string" },
          "item_hash": { "type": "string" },
          "item_price": { "type": "string" },
          "currency_code": { "type": "string", "minLength": 3, "maxLength": 3 },
          "protection_fee": { "type": "string" },
          "expires_at": { "type": "string", "format": "date-time" },
          "hmac_signature": { "type": "string" }
        }
      },
      "QuoteRequest": {
        "type": "object",
        "required": ["merchant_id", "item_hash", "item_title", "item_price", "currency_code"],
        "properties": {
          "merchant_id": { "type": "string" },
          "item_hash": { "type": "string" },
          "item_title": { "type": "string" },
          "item_price": { "type": "string" },
          "currency_code": { "type": "string", "minLength": 3, "maxLength": 3 }
        }
      },
      "QuoteResponse": {
        "type": "object",
        "required": ["assessment", "quote"],
        "properties": {
          "assessment": { "$ref": "#/components/schemas/RiskAssessment" },
          "quote": { "oneOf": [ { "$ref": "#/components/schemas/ProtectionQuote" }, { "type": "null" } ] }
        }
      },
      "CreateOrderRequest": {
        "type": "object",
        "required": ["quote_id", "opt_in", "buyer_ref"],
        "properties": {
          "quote_id": { "type": "string" },
          "opt_in": { "type": "boolean" },
          "buyer_ref": { "type": "string" }
        }
      },
      "CreateOrderResponse": {
        "type": "object",
        "required": ["order_id", "internal_order_id", "status", "total", "currency_code"],
        "properties": {
          "order_id": { "type": "string", "description": "PayPal order id" },
          "internal_order_id": { "type": "string" },
          "status": { "type": "string" },
          "total": { "type": "string" },
          "currency_code": { "type": "string", "minLength": 3, "maxLength": 3 }
        }
      },
      "CaptureResponse": {
        "type": "object",
        "required": ["order_id", "paypal_capture_id", "status"],
        "properties": {
          "order_id": { "type": "string" },
          "paypal_capture_id": { "type": "string" },
          "status": { "type": "string" }
        }
      },
      "ClaimRecord": {
        "type": "object",
        "required": ["claim_id", "order_id", "state", "claim_amount", "currency_code", "updated_at"],
        "properties": {
          "claim_id": { "type": "string" },
          "order_id": { "type": "string" },
          "state": { "$ref": "#/components/schemas/ClaimState" },
          "claim_amount": { "type": "string" },
          "currency_code": { "type": "string", "minLength": 3, "maxLength": 3 },
          "decision": { "description": "arbiter decision, present after evidence check" },
          "refund_id": { "type": "string" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "LedgerSummary": {
        "type": "object",
        "required": ["total_volume", "protection_fees_collected", "refunds_issued", "net_loss_ratio"],
        "properties": {
          "total_volume": { "type": "string" },
          "protection_fees_collected": { "type": "string" },
          "refunds_issued": { "type": "string" },
          "net_loss_ratio": { "type": "string" }
        }
      },
      "TransactionRow": {
        "type": "object",
        "required": ["internal_order_id", "merchant_id", "item_price", "protection_fee", "r_final", "state", "created_at"],
        "properties": {
          "internal_order_id": { "type": "string" },
          "merchant_id": { "type": "string" },
          "item_price": { "type": "string" },
          "protection_fee": { "type": "string" },
          "r_final": { "type": "string" },
          "state": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "MerchantTrustRow": {
        "type": "object",
        "required": ["merchant_id", "total_orders", "successful_orders", "verified_fraud_claims", "trust_score", "m_penalty"],
        "properties": {
          "merchant_id": { "type": "string" },
          "total_orders": { "type": "integer", "minimum": 0 },
          "successful_orders": { "type": "integer", "minimum": 0 },
          "verified_fraud_claims": { "type": "integer", "minimum": 0 },
          "trust_score": { "type": "string" },
          "m_penalty": { "type": "string" }
        }
      }
    }
  }
}
