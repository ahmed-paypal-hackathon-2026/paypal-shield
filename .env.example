#
# PayPal Shield environment template - Person 4.
# Copy to .env and fill values. Never commit .env.
#

# --- Application ------------------------------------------------------
# Pull toward the safe default: everything Sandbox unless explicitly overridden.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
ALLOW_NON_SANDBOX=false

DEMO_DETERMINISTIC_MODE=true

# CORS origins for the storefront (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- PayPal credentials (Sandbox) --------------------------------------
# Create at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Quote signing (HMAC-SHA256) ---------------------------------------
# Key used to sign and verify Buyer Protection Fee quotes. 32+ bytes.
QUOTES_HMAC_KEY=replace-me-with-openssl-rand-hex-32

# --- Reviewer/admin endpoint -------------------------------------------
CLAIM_REVIEWER_TOKEN=replace-me

# --- Databases ----------------------------------------------------------
# Local docker-compose Postgres
DATABASE_URL=postgresql+psycopg://shield:shield@postgres:5432/shield
# SQLite fallback for quick local tests
SQLITE_URL=sqlite+aiosqlite:///./shield.db

# --- Frontend build-time ------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_PAYPAL_CLIENT_ID=
VITE_ALLOW_MOCK=true
